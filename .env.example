# Required
DATABASE_URL=postgresql://user:password@localhost:5432/crew
CMA_ADMIN_TOKEN=            # openssl rand -hex 32
ID_ENCRYPTION_KEY=          # openssl rand -hex 32 (back this up; losing it makes stored ID uploads unreadable)
NODE_ENV=production

# Optional: per-admin tokens so the audit log names the actor: "alice:<24+ char token>,bob:<24+ char token>"
CMA_ADMIN_TOKENS=

# Optional: verify the Postgres TLS certificate (PEM, newlines may be written as \n) or trust a public CA
DATABASE_SSL_CA=
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Set true to turn on online payments (Bachs). When false, /api/payments/initialize returns 503.
PAYMENTS_ENABLED=false
# Bachs hosted checkout. Use sk_test_... until you go live (the API base is picked from the key prefix).
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
# Public https URL of this app, used for checkout return links (e.g. https://yourapp.up.railway.app)
APP_URL=
SUPPLIER_TIN=               # printed on invoices; leave blank until you have a real one

REQUIRE_ACCOUNT_APPROVAL=false

# SendByte transactional email (verification, password reset, booking and message alerts).
# Leave blank to run without email; email verification is then not enforced.
SENDBYTE_API_KEY=
# Verified sender, e.g. Crew Management <noreply@yourdomain.com>
MAIL_FROM=

# Named admin accounts with an authenticator-app code (Admin tab > Admins).
# 64 hex characters used to encrypt each admin's 2FA secret. Falls back to ID_ENCRYPTION_KEY when blank.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_2FA_KEY=
# After every admin has their own account, set to "disabled" to switch off the shared CMA_ADMIN_TOKEN login.
ADMIN_TOKEN_AUTH=
